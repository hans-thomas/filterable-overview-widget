{
    "name": "hans-thomas/filterable-overview-widget",
    "description": "This widget enables you to filter your overview data and apply conditions on your stats.",
    "keywords": [
        "hans-thomas",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-widget",
        "filterable stats overview widget"
    ],
    "homepage": "https://github.com/hans-thomas/filterable-overview-widget",
    "support": {
        "issues": "https://github.com/hans-thomas/filterable-overview-widget/issues",
        "source": "https://github.com/hans-thomas/filterable-overview-widget"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Hans Thomas",
            "email": "s.mohammad027@live.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4|^5",
        "filament/forms": "^4|^5",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9|^10|^11",
        "pestphp/pest": "^3|^4|^5",
        "pestphp/pest-plugin-arch": "^3|^4|^5",
        "pestphp/pest-plugin-laravel": "^3|^4|^5",
        "pestphp/pest-plugin-livewire": "^3|^4|^5",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Hans\\FilterableOverviewWidget\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hans\\FilterableOverviewWidget\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "ignore": [
                "PKSA-m5cs-t1y6-qpcs",
                "PKSA-3r5d-mb8f-1qw9",
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-8qx3-n5y5-vvnd",
                "PKSA-w7xr-vk7n-rstm",
                "PKSA-csyb-yc4p-mnbs"
            ]
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hans\\FilterableOverviewWidget\\FilterableOverviewWidgetServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
